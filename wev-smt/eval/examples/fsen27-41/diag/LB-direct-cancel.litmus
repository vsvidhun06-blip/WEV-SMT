C LB-direct-cancel
(* FSEN-revision diagnostic input (2026-11-05); NOT original evidence.            *)
(* Same composed store expression as LB-chain-cancel, written as one instruction. *)
{ }

P0(int *x, int *y) {
  r0 = READ_ONCE(*y);
  s0 = r0 + 1 - r0;
  WRITE_ONCE(*x, s0);
}

P1(int *x, int *y) {
  r1 = READ_ONCE(*x);
  s1 = r1 + 1 - r1;
  WRITE_ONCE(*y, s1);
}

exists (0:r0=1 /\ 1:r1=1)
