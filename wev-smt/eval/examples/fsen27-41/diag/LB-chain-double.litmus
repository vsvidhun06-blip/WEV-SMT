C LB-chain-double
(* FSEN-revision diagnostic input (2026-11-05); NOT original evidence.            *)
(* The P_x companion: t := r+r; s := t - r. Same instruction-local summaries as  *)
(* LB-chain-cancel, but the composed label (L+L)-L = L is a real dependency.     *)
(* The outcome r0=r1=1 is value-consistent (each store writes the value read).   *)
{ }

P0(int *x, int *y) {
  r0 = READ_ONCE(*y);
  t0 = r0 + r0;
  s0 = t0 - r0;
  WRITE_ONCE(*x, s0);
}

P1(int *x, int *y) {
  r1 = READ_ONCE(*x);
  t1 = r1 + r1;
  s1 = t1 - r1;
  WRITE_ONCE(*y, s1);
}

exists (0:r0=1 /\ 1:r1=1)
