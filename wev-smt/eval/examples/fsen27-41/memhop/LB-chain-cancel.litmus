C LB-chain-cancel
(* FSEN-revision diagnostic input (2026-11-05); NOT original evidence.            *)
(* The worked example: each thread computes t := r+1; s := t - r and stores s.   *)
(* Composed store label (L+1)-L = 1 is constant: no semantic dependency.         *)
(* Every instruction-local site is non-constant, so the prototype closure keeps  *)
(* the chain r -> t -> s.                                                         *)
{ }

P0(int *x, int *y) {
  r0 = READ_ONCE(*y);
  t0 = r0 + 1;
  s0 = t0 - r0;
  WRITE_ONCE(*x, s0);
}

P1(int *x, int *y) {
  r1 = READ_ONCE(*x);
  t1 = r1 + 1;
  s1 = t1 - r1;
  WRITE_ONCE(*y, s1);
}

exists (0:r0=1 /\ 1:r1=1)
