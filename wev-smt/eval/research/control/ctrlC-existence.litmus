C ctrlC-existence
(* GATE 2 case C: existence control. One arm writes, the other does not, so the   *)
(* dependence is structural rather than value-carrying. Expected: REAL.           *)
{ }
P0(int *x, int *y) { r0 = READ_ONCE(*y); if (r0 == 1) WRITE_ONCE(*x, 1); }
P1(int *x, int *y) { r1 = READ_ONCE(*x); WRITE_ONCE(*y, 1); }
exists (0:r0=1 /\ 1:r1=1)
